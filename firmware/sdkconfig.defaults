# Waveshare ESP32-S3-Touch-LCD-4.3 (ESP32-S3N16R8)
# Settings carried over from the aclock project, which runs on the same board.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: the app (2 MB) and the standalone config (partitions.csv).
# Changing it needs a full flash (idf.py flash), not just the app.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM. Running code and read-only data from PSRAM keeps the
# RGB panel fed while flash is busy.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# CPU and cache
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 64-byte cache lines halve the cache misses when the bounce fill reads page
# buffers from PSRAM. 64-byte lines need the 64 KB data cache.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Logs go to UART0, which is the CH343P USB-to-UART port. TinyUSB has the
# native port, so no secondary console on USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# TinyUSB: the vendor interface for the host protocol (docs/protocol.md).
# Bigger FIFOs than the defaults (64) so uploads stream; the endpoint buffer
# lets one transfer carry several 64-byte packets.
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=2048
CONFIG_TINYUSB_VENDOR_EPSIZE=512

# GT911 touch
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5

# Bounce-buffer mode: if a fill is ever late, the panel image shifts and
# stays shifted. This resyncs the DMA at every VSYNC, so a late fill costs
# one bad frame instead.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
