# Waveshare ESP32-S3-Touch-LCD-4.3 (ESP32-S3N16R8)
# Settings carried over from the aclock project, which runs on the same board.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: the app (2 MB) and the standalone config (partitions.csv).
# Changing it needs a full flash (idf.py flash), not just the app.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM. Running code and read-only data from PSRAM keeps the
# RGB panel fed while flash is busy.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# CPU and cache
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 64-byte cache lines halve the cache misses when the bounce fill reads page
# buffers from PSRAM. 64-byte lines need the 64 KB data cache.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Logs go to UART0, which is the CH343P USB-to-UART port. TinyUSB has the
# native port, so no secondary console on USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# TinyUSB: the vendor interface for the host protocol (docs/protocol.md).
# Bigger FIFOs than the defaults (64) so uploads stream; the endpoint buffer
# lets one transfer carry several 64-byte packets.
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=2048
CONFIG_TINYUSB_VENDOR_EPSIZE=512
# The host going away (unplug or suspend) hands the device back to standalone
# mode (docs/standalone.md "Runtime modes"). Unplug needs no option.
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
# One HID keyboard interface for the standalone hidKey op (usb.cpp). 0 backs it
# out (also bump USB_BCD_DEVICE).
CONFIG_TINYUSB_HID_COUNT=1

# Wi-Fi (docs/wifi.md): station only, a few small HTTP/UDP requests, not streaming.
# Smaller buffers than the defaults (static RX 10, dynamic RX/TX 32, AMPDU
# windows 6) to keep internal RAM for the display and USB. Wi-Fi/lwIP stay in
# internal RAM (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP off): PSRAM writes starve
# the bounce fill. Core 0 for the driver and lwIP; core 1 is the compositor's.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# IRAM and internal RAM are one SRAM on the S3: keep the driver out of IRAM.
# Tried on (with LWIP_IRAM_OPTIMIZATION): they cost ~36 KB of internal RAM and
# didn't help latency (the cause was panel pin noise: wip/wip-wifi-latency.md).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# The net worker (net_worker.cpp) speaks plain http:// only (the bake and the
# blob validator reject https://): leave TLS out of esp_http_client.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# GT911 touch
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5

# Bounce-buffer mode: if a fill is ever late, the panel image shifts and
# stays shifted. This resyncs the DMA at every VSYNC, so a late fill costs
# one bad frame instead.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
