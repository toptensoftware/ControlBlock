{
  "version": 1,
  "settings": { "longPressMs": 650 },
  "defaults": { "color": "#22262e", "iconColor": "white", "pressed": { "color": "#3a86ff" } },
  "devices": {
    "tv": {
      "turnOn": { "op": "sendWol", "mac": "AA:BB:CC:DD:EE:FF", "broadcast": "10.0.0.255" },
      "turnOff": { "op": "httpPost", "url": "http://tv.local/off", "body": "x=1" }
    },
    "avr": { "turnOn": { "op": "httpGet", "url": "http://avr.local/on", "headers": { "X-A": "1" } } }
  },
  "home": {
    "keys": [
      { "icon": "#play", "label": "Play", "action": { "op": "hidKey", "keys": "space" } },
      { "icon": "#next-track", "label": "Next", "tap": { "op": "hidKey", "keys": "ctrl+right" }, "long": { "op": "delay", "ms": 100 } },
      { "icon": "#volume-mute", "label": "Watch", "action": { "op": "switchActivity", "activity": "Watch" } },
      null,
      { "color": "#aa2222" },
      null,
      { "color": "#225522", "icon": "#play", "label": "Copy", "tap": { "op": "hidKey", "keys": "ctrl+c" } },
      { "color": "#222255", "icon": "#play", "label": "Hold","press": { "op": "hidKey", "keys": "shift+a", "mode": "hold" }, "release": { "op": "hidKey", "keys": "shift+a", "mode": "hold" } },
      null,
      { "color": "#552222", "action": { "op": "switchActivity", "activity": null } },
      { "w": 2, "color": "#224444", "label": "Wide", "longPressMs": 900, "tap": { "op": "hidKey", "keys": "w" } },
      null,
      { "x": 2, "y": 2, "w": 0.5, "label": "Q", "tap": { "op": "hidKey", "keys": "q" } },
      { "x": 2.5, "y": 2, "w": 0.5, "label": "R", "tap": { "op": "hidKey", "keys": "r" } },
      { "x": 3, "y": 2, "w": 2, "label": "Vol", "keys": [
        { "icon": "#add", "tap": { "op": "hidKey", "keys": "up" } },
        { "x": 1, "icon": "#delete", "tap": { "op": "hidKey", "keys": "down" } }
      ] }
    ]
  },
  "activities": {
    "Watch": {
      "displayName": "Watch TV",
      "devices": ["tv", "avr"],
      "hooks": { "didActivate": { "op": "udpPacket", "host": "10.0.0.5", "port": 9, "data": "hi" } },
      "pages": [
        { "keys": [ { "icon": "#play", "label": "Go", "action": { "op": "script", "lua": "return param" } } ] },
        { "keys": [ { "icon": "#next-track", "label": "N" } ] }
      ],
      "bindings": [ { "control": "macro1", "event": "tap", "do": { "op": "hidKey", "keys": "ctrl+c" } } ]
    },
    "Listen": {
      "devices": ["avr"],
      "hooks": { "willActivate": { "op": "delay", "ms": 20 } },
      "pages": [ { "keys": [ { "icon": "#play" }, { "color": "#aa2222" } ] } ]
    }
  }
}
