# Macro pad MCU: ESP32-C3 (zero-style board). See pad/README.md.

CONFIG_IDF_TARGET="esp32c3"

# Logs stay on UART0 (the board's default console pins 20/21). The pad link is UART1 on
# another pin, so boot logs never reach the S3.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# 1 kHz tick: the key poll is vTaskDelayUntil(1 tick) and PadScanner::Poll wants >= 1 kHz.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# The encoder ISR reads pins and the esp_timer clock while flash may be busy.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Small flash parts are common on these boards.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
